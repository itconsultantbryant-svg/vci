# Obtain this from Neon after creating/linking your project. Never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=replace_with_a_long_random_secret

# Dashboard username; change this before production if preferred.
ADMIN_USERNAME=admin

# Set a strong, unique deployment password; store only in Vercel environment settings.
ADMIN_PASSWORD=replace_with_a_strong_admin_password
