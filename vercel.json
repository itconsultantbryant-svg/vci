{
  "rewrites": [
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/clients",
      "destination": "/index.html"
    },
    {
      "source": "/team",
      "destination": "/index.html"
    },
    {
      "source": "/policies",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/communications",
      "destination": "/index.html"
    },
    {
      "source": "/media-pr",
      "destination": "/index.html"
    },
    {
      "source": "/business-innovation",
      "destination": "/index.html"
    },
    {
      "source": "/monitoring-evaluation",
      "destination": "/index.html"
    },
    {
      "source": "/smart-techs",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "functions": {
    "index.js": {
      "includeFiles": [
        "index.html",
        "client.js",
        "styles.css",
        "assets/**",
        "api/**",
        "db/schema.sql"
      ]
    }
  }
}
